# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/atithi_restaurant_platform

# JWT Authentication
JWT_SECRET=replace_with_a_strong_64_char_random_secret
JWT_EXPIRES_IN=7d

# Frontend Origin (for CORS & Cookie configuration)
CLIENT_URL=http://localhost:5173

# Cookie Security (set true in HTTPS production)
COOKIE_SECURE=false

# ==========================================
# Email / SMTP Configuration (Gmail or Custom SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_atithi_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM=Atithi <your_atithi_email@gmail.com>

# ==========================================
# Client Configuration (client/.env)
# ==========================================
# Optional override; defaults to /api (proxied by Vite in development)
VITE_API_URL=/api
